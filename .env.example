# Copy to .env — .env is gitignored and must never be committed.

# Diagnosis layer (AI-1) — either provider works behind the same DiagnosisPort
# interface (agent/diagnosis/claude.py, agent/diagnosis/groq_diagnosis.py).
# Anthropic is paid; Groq's free tier needs no card. Set whichever you're using.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Razorpay TEST MODE ONLY. Live keys must never appear in this repo.
# Phase 2 uses these; Phase 1 does not call Razorpay at all.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
