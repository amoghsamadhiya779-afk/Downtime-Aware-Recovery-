# ==============================================================================
# Payment Recovery Control Plane - Environment Configuration Template
# Copy this file to '.env' and fill in the required values.
# IMPORTANT: '.env' is ignored by git and must NEVER be committed with live keys.
# ==============================================================================

# Application Environment (development | staging | production | test)
ENVIRONMENT=development

# Dashboard HTTP Server Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Operational Database Path
DATABASE_PATH=data/dev.db

# Policy Engine Rules Path
RULES_PATH=agent/policy/rules.yaml

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Active Diagnosis Provider (stub | baseline | groq | claude)
# Default is 'stub' (zero-network, deterministic heuristic diagnosis)
DIAGNOSIS_PROVIDER=stub

# ------------------------------------------------------------------------------
# LLM Provider Credentials (Required ONLY if DIAGNOSIS_PROVIDER is set accordingly)
# ------------------------------------------------------------------------------

# Anthropic Claude API Key (required when DIAGNOSIS_PROVIDER=claude)
ANTHROPIC_API_KEY=


# Groq API Key (required when DIAGNOSIS_PROVIDER=groq)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Razorpay Credentials (TEST MODE ONLY)
# ------------------------------------------------------------------------------
# Test mode keys for sandbox verification. Live production keys must NEVER appear in this repo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# Evaluation & Experimentation Overrides (Optional)
# ------------------------------------------------------------------------------
# Override default holdout fraction defined in rules.yaml (0.0 to 1.0)
# HOLDOUT_FRACTION=0.25
